{
    "name": "chrisreedio/socialment",
    "description": "Provides Socialite functionality for Filament.",
    "keywords": [
        "chrisreedio",
        "laravel",
        "filament",
        "socialment",
        "authentication",
        "socialite"
    ],
    "homepage": "https://github.com/chrisreedio/socialment",
    "support": {
        "issues": "https://github.com/chrisreedio/socialment/issues",
        "source": "https://github.com/chrisreedio/socialment"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Chris Reed",
            "email": "chris@reedtech.us",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "laravel/socialite": "^5.27",
        "owenvoke/blade-fontawesome": "^2.4|^3.2",
        "spatie/laravel-package-tools": "^1.93.1"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.13",
        "nunomaduro/collision": "^8.9.4",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.8.2|^4.4.1",
        "pestphp/pest-plugin-arch": "^3.1.1|^4.0.2",
        "pestphp/pest-plugin-laravel": "^3.2|^4.1",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "socialiteproviders/manager": "^4.9.2"
    },
    "autoload": {
        "psr-4": {
            "ChrisReedIO\\Socialment\\": "src/",
            "ChrisReedIO\\Socialment\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ChrisReedIO\\Socialment\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ChrisReedIO\\Socialment\\SocialmentServiceProvider"
            ],
            "aliases": {
                "Socialment": "ChrisReedIO\\Socialment\\Facades\\Socialment"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
